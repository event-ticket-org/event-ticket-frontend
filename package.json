{
  "name": "event-ticket-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "contract": "openapi-typescript contracts/openapi.yaml -o src/api/schema.d.ts",
    "predev": "npm run contract",
    "dev": "vite",
    "prebuild": "npm run contract",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "npm run contract",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run contract",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tanstack/react-query": "^5.62.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
